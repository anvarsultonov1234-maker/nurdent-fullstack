# Supabase Configuration
# Bularni supabase.com dagi Project Settings -> API bo'limidan oling
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot API Configuration
# BotFather dan olingan bot token: masalan, 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Buyurtmalar yuboriladigan Telegram chat yoki admin ID (masalan, @userinfobot dan olingan ID)
TELEGRAM_CHAT_ID=123456789
